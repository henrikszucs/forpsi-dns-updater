# Copy to /etc/dns-updater.env and restrict it: chmod 600 /etc/dns-updater.env
FORPSI_USERNAME=your-forpsi-user
FORPSI_PASSWORD=your-forpsi-password
# Comma-separated; subdomains are fine (the A record for the host part is updated/created)
DNS_UPDATER_DOMAINS=example.com,home.example.com
# Minutes between public IP checks
DNS_UPDATER_INTERVAL=5
